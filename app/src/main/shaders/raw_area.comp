#version 450
#extension GL_GOOGLE_include_directive : require

#define UNSPEKTRA_PREVIEW_SCALAR_SHADING 1
#define UNSPEKTRA_PREVIEW_SHADING_REUSE 1
#define UNSPEKTRA_RAW_UNPACK_PASS 1
#include "raw_input.glsl"

layout(local_size_x = 16, local_size_y = 8) in;
layout(set = 0, binding = 9, rgba16f) uniform writeonly image2D filteredRaw;
layout(set = 0, binding = 13, std430) readonly buffer AreaWeights { vec4 values[]; } areaWeights;

#include "raw_packed_quad.glsl"

void main()
{
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    position.y += max(int(floor(frameGeometry.sourceCrop.y * float(rawParams.dimensions.y))) - 2, 0) & ~7;
    int columns = (frameGeometry.transform.x & 1) != 0 ? rawParams.dimensions.w : rawParams.dimensions.z;
    if (position.x >= columns || position.y >= rawParams.dimensions.y) return;
    if (position.y < frameGeometry.rawBounds.y ||
        position.y >= frameGeometry.rawBounds.y + frameGeometry.rawBounds.w) return;
    float footprint = frameGeometry.sourceCrop.z * float(rawParams.dimensions.x) / float(columns);
    float lower = frameGeometry.sourceCrop.x * float(rawParams.dimensions.x) + float(position.x) * footprint;
    int first = (int(floor(lower)) - 2) & ~3;
    int blocks = (int(ceil(footprint)) + 11) / 4;
    ivec2 levels = ivec2(cfaLevelIndex(ivec2(0, position.y)), cfaLevelIndex(ivec2(1, position.y)));
    vec2 black = vec2(rawParams.blackLevel[levels.x], rawParams.blackLevel[levels.y]);
    vec2 white = vec2(rawParams.whiteLevel[levels.x], rawParams.whiteLevel[levels.y]);
    vec2 scale = 1.0 / (max(white - black, vec2(1.0)) * footprint);
    vec2 limit = ceil(mix(black, white, 0.98));
    vec3 even = vec3(0.0);
    vec3 odd = vec3(0.0);
    float clipped = 0.0;
    for (int block = 0; block < blocks; ++block) {
        int x = first + block * 4;
        int index = (position.x * blocks + block) * 3;
        vec4 center = areaWeights.values[index];
        vec4 near = areaWeights.values[index + 1];
        vec4 far = areaWeights.values[index + 2];
        vec4 sensor = rawPackedFour(ivec2(x, position.y));
        vec4 value = max(sensor - black.xyxy, vec4(0.0)) * scale.xyxy;
        even += value.x * vec3(center.x, near.x, far.x) + value.z * vec3(center.z, near.z, far.z);
        odd += value.y * vec3(center.y, near.y, far.y) + value.w * vec3(center.w, near.w, far.w);
        if (rawColor.reserved1.z > 0.5)
            clipped = max(clipped, dot(vec4(greaterThanEqual(sensor, limit.xyxy)), center) > 0.0 ? 1.0 : 0.0);
    }
    imageStore(filteredRaw, ivec2(position.x * 2, position.y), vec4(even, clipped));
    imageStore(filteredRaw, ivec2(position.x * 2 + 1, position.y), vec4(odd, clipped));
}
