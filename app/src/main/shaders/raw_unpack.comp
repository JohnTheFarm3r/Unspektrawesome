#version 450
#extension GL_GOOGLE_include_directive : require

#define UNSPEKTRA_PREVIEW_SCALAR_SHADING 1
#define UNSPEKTRA_RAW_UNPACK_PASS 1
#include "raw_input.glsl"

layout(local_size_x = 16, local_size_y = 8) in;
layout(set = 0, binding = 9, r16) uniform writeonly image2D unpackedRaw;

void main()
{
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(position, rawParams.dimensions.xy))) return;
    if (any(lessThan(position, frameGeometry.rawBounds.xy)) ||
        any(greaterThanEqual(position, frameGeometry.rawBounds.xy + frameGeometry.rawBounds.zw))) return;
    imageStore(unpackedRaw, position, vec4(float(rawIntegerAt(position)) / 65535.0));
}
