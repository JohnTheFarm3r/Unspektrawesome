#version 450
#extension GL_GOOGLE_include_directive : require
// Final pass of darktable's "inpaint opposed" highlight reconstruction:
// https://github.com/darktable-org/darktable/blob/master/src/iop/hlreconstruct/opposed.c
// Copyright (C) 2022-2026 darktable developers. GNU General Public License version 3 or later.
// Modified for Vulkan shaders.
#include "amaze/amaze_common.glsl"
layout(local_size_x_id = 12, local_size_y_id = 13, local_size_z = 1) in;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D outputImage;
layout(set = 0, binding = 6) uniform sampler2D hrTmpImage;
layout(set = 0, binding = 7) uniform sampler2D demosaicImage;
layout(set = 0, binding = 11) readonly buffer HrReduce {
    int chromaSum[3]; uint chromaCount[3];
} hrReduce;
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(p.x>=AMAZE_WIDTH || p.y>=AMAZE_HEIGHT) return;
    vec3 chrominance;
    for(int c=0;c<3;++c) chrominance[c]=float(hrReduce.chromaSum[c]) /
        (max(float(hrReduce.chromaCount[c]),1.0)*HR_REDUCE_SCALE);
    vec3 rgb=applyOpposedHighlightRecovery(texelFetch(demosaicImage,p,0).rgb,
        texelFetch(hrTmpImage,p,0).rgb,chrominance,hrWhiteBalance(rawColor.whiteBalanceExposure.xyz));
    rgb*=rawColor.whiteBalanceExposure.xyz;
    if(any(isnan(rgb)) || any(isinf(rgb))) rgb=vec3(0.0);
    rgb=clamp(rgb,vec3(0.0),vec3(16.0));
    vec2 uv=(vec2(p+frameGeometry.rawBounds.xy)+0.5)/vec2(rawParams.dimensions.xy);
    vec4 shading=rawLensGains(geometryLensShadingUv(uv,rawParams.dimensions.xy));
    rgb*=vec3(shading.r,0.5*(shading.g+shading.b),shading.a);
    imageStore(outputImage,p,vec4(max(rgb,vec3(0.0)),1.0));
}
