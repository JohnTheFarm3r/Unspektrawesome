#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, r16f) readonly uniform image2D inputImage;
layout(set = 0, binding = 1, r16f) readonly uniform image2D guideImage;
layout(set = 0, binding = 2, r16f) writeonly uniform image2D outputImage;

layout(push_constant) uniform PushConstants {
    int width;
    int height;
    int horizontal;
    int radius;
    float sigmaSpatial;
    float sigmaRange;
} pc;

ivec2 clampCoord(ivec2 p, ivec2 size) {
    return clamp(p, ivec2(0), size - ivec2(1));
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(pc.width, pc.height);
    if (any(greaterThanEqual(gid, size))) return;

    float center = imageLoad(guideImage, gid).x;
    vec2 axis = (pc.horizontal != 0) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
    float sigmaS2 = max(pc.sigmaSpatial * pc.sigmaSpatial * 2.0, 1e-5);
    float sigmaR2 = max(pc.sigmaRange * pc.sigmaRange * 2.0, 1e-5);

    float weighted = 0.0;
    float weightSum = 0.0;
    int radius = clamp(pc.radius, 1, 32);
    for (int i = -32; i <= 32; ++i) {
        if (i < -radius || i > radius) continue;
        ivec2 p = clampCoord(gid + ivec2(axis * float(i)), size);
        float guide = imageLoad(guideImage, p).x;
        float sampleValue = imageLoad(inputImage, p).x;
        float spatialW = exp(-(float(i * i)) / sigmaS2);
        float rangeDelta = guide - center;
        float rangeW = exp(-(rangeDelta * rangeDelta) / sigmaR2);
        float w = spatialW * rangeW;
        weighted += sampleValue * w;
        weightSum += w;
    }

    float outValue = weighted / max(weightSum, 1e-5);
    imageStore(outputImage, gid, vec4(outValue, 0.0, 0.0, 0.0));
}
