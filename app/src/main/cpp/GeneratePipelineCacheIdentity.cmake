file(STRINGS "${INPUT_LIST}" cache_inputs)
set(fingerprint "")
foreach(cache_input IN LISTS cache_inputs)
    file(SHA256 "${cache_input}" input_hash)
    get_filename_component(input_name "${cache_input}" NAME)
    string(APPEND fingerprint "${input_name}:${input_hash}\n")
endforeach()
string(SHA256 build_hash "${fingerprint}")
set(header "#pragma once\n\ninline constexpr char kShaderPreparationIdentity[] = \"${build_hash}\";\n")
set(previous_header "")
if(EXISTS "${OUTPUT_FILE}")
    file(READ "${OUTPUT_FILE}" previous_header)
endif()
if(NOT header STREQUAL previous_header)
    file(WRITE "${OUTPUT_FILE}" "${header}")
endif()
