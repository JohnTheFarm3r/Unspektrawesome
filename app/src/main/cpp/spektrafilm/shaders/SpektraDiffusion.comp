#if defined(SPEKTRA_PREVIEW_OPTIMIZATIONS)
shared float blurWeights[257];
shared float blurWeightSum;

void prepareBlurWeights(float sigma, int radius) {
  if (gl_LocalInvocationIndex != 0u) return;
  blurWeightSum = 1.0;
  if (radius == 0) return;
  const float invSigma2 = 1.0 / max(sigma * sigma, 1.0e-8);
  float weight = exp(-0.5 * invSigma2);
  float ratio = exp(-1.5 * invSigma2);
  const float ratioStep = exp(-invSigma2);
  for (int offset = 1; offset <= radius; ++offset) {
    blurWeights[offset] = weight;
    blurWeightSum += 2.0 * weight;
    weight *= ratio;
    ratio *= ratioStep;
  }
}

vec4 sampleSharedGaussian(uvec2 gid, bool horizontal, int radius) {
  const ivec2 position = ivec2(gid);
  vec4 value = sampleBlurTile(position.x, position.y);
  for (int offset = 1; offset <= radius; ++offset) {
    const ivec2 delta = horizontal ? ivec2(offset, 0) : ivec2(0, offset);
    const vec4 pair = sampleBlurTile(position.x - delta.x, position.y - delta.y) +
      sampleBlurTile(position.x + delta.x, position.y + delta.y);
    value.rgb += pair.rgb * blurWeights[offset];
    value.a += pair.a;
  }
  value.rgb /= max(blurWeightSum, 1.0e-8);
  value.a /= float(radius * 2 + 1);
  return value;
}

bool renderSharedBlur() {
  const bool horizontal = SPEKTRA_OPERATION == kOpBlurX || SPEKTRA_OPERATION == kOpGroupBlurX ||
    SPEKTRA_OPERATION == kOpDownsampleBlurX || SPEKTRA_OPERATION == kOpDownsampleGroupBlurX;
  const bool vertical = SPEKTRA_OPERATION == kOpBlurYAccumulate || SPEKTRA_OPERATION == kOpGroupBlurYAccumulate ||
    SPEKTRA_OPERATION == kOpDownsampleBlurY || SPEKTRA_OPERATION == kOpDownsampleGroupBlurY;
  if (!horizontal && !vertical) return false;

  const bool reduced = SPEKTRA_OPERATION == kOpDownsampleBlurX || SPEKTRA_OPERATION == kOpDownsampleGroupBlurX ||
    SPEKTRA_OPERATION == kOpDownsampleBlurY || SPEKTRA_OPERATION == kOpDownsampleGroupBlurY;
  const bool grouped = SPEKTRA_OPERATION == kOpGroupBlurX || SPEKTRA_OPERATION == kOpGroupBlurYAccumulate ||
    SPEKTRA_OPERATION == kOpDownsampleGroupBlurX || SPEKTRA_OPERATION == kOpDownsampleGroupBlurY;
  const uint scale = reduced ? downsampleScaleFromPacked(params._pad2) : 1u;
  const uint groupCount = grouped ? (reduced ? groupCountFromPacked(params._pad2) : max(params._pad2, 1u)) : 1u;
  blurSourceWidth = reduced ? downsampleWidth(scale) : params.width;
  blurSourceHeight = reduced ? downsampleHeight(scale) : params.height;
  blurSourceKind = reduced ? (horizontal ? 2u : 3u) : (horizontal ? 0u : 1u);
  const uvec2 origin = reduced ? uvec2(0) : uvec2(params.activeOriginX, params.activeOriginY);
  const uvec2 gid = gl_GlobalInvocationID.xy + origin;
  const uint activeWidth = reduced ? blurSourceWidth : (params.activeWidth == 0u ? params.width : params.activeWidth);
  const uint activeHeight = reduced ? blurSourceHeight : (params.activeHeight == 0u ? params.height : params.activeHeight);
  const bool valid = gl_GlobalInvocationID.x < activeWidth && gl_GlobalInvocationID.y < activeHeight &&
    gid.x < blurSourceWidth && gid.y < blurSourceHeight;
  const uint index = gid.y * blurSourceWidth + gid.x;
  const uint planePixelCount = blurSourceWidth * blurSourceHeight;
  vec3 accumulated = vec3(0.0);
  float alpha = 0.0;
  if (valid && vertical && !reduced) {
    accumulated = loadAccumPixel(index).rgb;
    alpha = loadSourcePixel(index).a;
  }
  for (uint group = 0u; group < groupCount; ++group) {
    const uint componentIndex = min(params.componentIndex + group, max(diffusionInfo.componentCount, 1u) - 1u);
    const vec4 component = components[componentIndex];
    const float sigma = max(component.x / float(scale), 1.0e-6);
    const int radius = sigma <= 1.0e-4 ? 0 : min(int(ceil(3.0 * sigma)), 256);
    blurSourcePlane = horizontal ? 0u : group;
    prepareBlurWeights(sigma, radius);
    prepareBlurTile(ivec2(origin), horizontal, radius);
    if (valid) {
      if (reduced) {
        if (horizontal) {
          storeDownsampleTempPixel(groupedIndex(index, group, planePixelCount),
            sampleSharedGaussian(gid, horizontal, radius));
        } else {
          storeDownsampleBlurPixel(groupedIndex(index, group, planePixelCount),
            sampleSharedGaussian(gid, horizontal, radius));
        }
      } else if (horizontal) {
        storeTempPixel(groupedIndex(index, group, planePixelCount), sampleSharedGaussian(gid, horizontal, radius));
      } else {
        const vec4 blurred = sampleSharedGaussian(gid, horizontal, radius);
        accumulated += blurred.rgb * component.yzw;
        alpha = blurred.a;
      }
    }
    // Every invocation finishes reading before the next component reuses the tile.
    barrier();
  }
  if (valid && vertical && !reduced) storeAccumPixel(index, vec4(accumulated, alpha));
  return true;
}

void main() {
  if (renderSharedBlur()) return;
  const uvec2 dispatchGid = gl_GlobalInvocationID.xy;
  if (SPEKTRA_OPERATION == kOpDownsample) {
    const uvec2 gid = dispatchGid;
    const uint scale = max(params.componentIndex, 1u);
    const uint reducedWidth = downsampleWidth(scale);
    const uint reducedHeight = downsampleHeight(scale);
    if (gid.x >= reducedWidth || gid.y >= reducedHeight) {
      return;
    }
    storeDownsampleSourcePixel(gid.y * reducedWidth + gid.x, downsampleSource(gid, scale));
    return;
  }

  const uint activeWidth = params.activeWidth == 0u ? params.width : params.activeWidth;
  const uint activeHeight = params.activeHeight == 0u ? params.height : params.activeHeight;
  if (dispatchGid.x >= activeWidth || dispatchGid.y >= activeHeight) {
    return;
  }
  const uvec2 gid = dispatchGid + uvec2(params.activeOriginX, params.activeOriginY);
  if (gid.x >= params.width || gid.y >= params.height) {
    return;
  }

  const uint index = gid.y * params.width + gid.x;
  if (SPEKTRA_OPERATION == kOpClear) {
    storeAccumPixel(index, vec4(0.0, 0.0, 0.0, loadSourcePixel(index).a));
    return;
  }
  if (SPEKTRA_OPERATION == kOpDownsampleUpsampleAccumulate || SPEKTRA_OPERATION == kOpDownsampleGroupUpsampleAccumulate) {
    const uint groupCount = SPEKTRA_OPERATION == kOpDownsampleGroupUpsampleAccumulate ? groupCountFromPacked(params._pad2) : 1u;
    const uint scale = downsampleScaleFromPacked(params._pad2);
    const uint reducedWidth = downsampleWidth(scale);
    const uint reducedHeight = downsampleHeight(scale);
    const vec2 absoluteGid = vec2(gid + uvec2(params.tileOriginX, params.tileOriginY));
    const vec2 reducedPos = (absoluteGid + vec2(0.5)) / float(scale) - vec2(0.5);
    const ivec2 baseGlobal = ivec2(floor(reducedPos));
    const ivec2 base = baseGlobal -
      ivec2(int(downsampleStartX(scale)), int(downsampleStartY(scale)));
    const vec2 t = clamp(reducedPos - vec2(baseGlobal), vec2(0.0), vec2(1.0));
    vec3 accumulated = loadAccumPixel(index).rgb;
    float alpha = loadSourcePixel(index).a;
    for (uint group = 0u; group < groupCount; ++group) {
      const uint componentIndex = min(params.componentIndex + group, max(diffusionInfo.componentCount, 1u) - 1u);
      const vec4 component = components[componentIndex];
      const vec4 s00 = sampleDownsampleBlur(base.x, base.y, group, reducedWidth, reducedHeight);
      const vec4 s10 = sampleDownsampleBlur(base.x + 1, base.y, group, reducedWidth, reducedHeight);
      const vec4 s01 = sampleDownsampleBlur(base.x, base.y + 1, group, reducedWidth, reducedHeight);
